    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@acenz/tsconfig": "workspace:*",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  }
}
