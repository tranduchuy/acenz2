{
  "name": "@acenz/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./src/tokens.json",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/build-css.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@acenz/tsconfig": "workspace:*",
    "tsup": "^9.0.0"
  }
}
