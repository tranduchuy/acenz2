{
  "name": "@acenz/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env dist/index.js\"",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "db:export": "node scripts/db-export.js",
    "db:import": "node scripts/db-import.js",
    "migration:generate": "pnpm build && node --env-file-if-exists=../../.env node_modules/typeorm/cli.js -d dist/db/data-source.js migration:generate",
    "migration:run": "pnpm build && node --env-file-if-exists=../../.env node_modules/typeorm/cli.js -d dist/db/data-source.js migration:run",
    "migration:revert": "pnpm build && node --env-file-if-exists=../../.env node_modules/typeorm/cli.js -d dist/db/data-source.js migration:revert"
  },
  "dependencies": {
    "@acenz/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@acenz/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
