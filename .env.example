NODE_ENV=development

# API
API_PORT=3000

# Postgres (docker compose, local dev only)
POSTGRES_USER=acenz
POSTGRES_PASSWORD=acenz
POSTGRES_DB=acenz
POSTGRES_PORT=5432
DATABASE_URL=postgres://acenz:acenz@localhost:5432/acenz

# JWT signing: required, min 32 chars. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_EXPIRES_IN_SECONDS=3600
